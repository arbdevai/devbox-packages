# DevBox Bootstrap Builder Configuration
# Pinned settings for DevBox (com.devbox.terminal) ARM64 bootstrap archives

# Application Identity
DEVBOX_APP_NAME="DevBox"
DEVBOX_APP_PACKAGE="com.devbox.terminal"
DEVBOX_APP_NAMESPACE="com.devbox.terminal"
DEVBOX_PREFIX="/data/data/com.devbox.terminal/files/usr"
DEVBOX_DATA_DIR="/data/data/com.devbox.terminal"
DEVBOX_HOME_DIR="/data/data/com.devbox.terminal/files/home"

# Target Architecture (ARM64 only)
DEVBOX_ARCH="aarch64"
DEVBOX_ANDROID_MIN_SDK=24

# Pinned Upstream Sources
UPSTREAM_REPO_URL="https://github.com/termux/termux-packages.git"
UPSTREAM_PINNED_COMMIT="62195791c21099ecd1fe54a5df517d4659ec195d"
BUILDER_CONTAINER_IMAGE="ghcr.io/termux/package-builder:latest"

# Build Configuration
# FORCE_REBUILD: 1 forces full source rebuild of all packages without using cached artifacts
FORCE_REBUILD=1
# INSTALL_DEPS: must ALWAYS be false/unset to prevent downloading com.termux prebuilt debs
INSTALL_DEPS=false
